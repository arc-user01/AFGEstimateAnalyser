# Database Configuration
# For Azure SQL use: DB_SERVER=your-server.database.windows.net,1433
# Password: use @ as-is or as %40 if your shell/env strips it
DB_SERVER=localhost,1433
DB_USER=sa
DB_PASSWORD=your_db_password_here
DB_NAME=testdb
# Optional: connection timeout in seconds (default 90 for Azure, 30 for local)
# DB_CONNECTION_TIMEOUT=90
# Optional: set to yes if Azure connection fails with certificate errors (e.g. corporate proxy)
# DB_TRUST_SERVER_CERTIFICATE=yes

# OpenAI / Azure OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://your-resource-name.openai.azure.com/openai/v1
OPENAI_MODEL_ID=gpt-4.1

# Path Configuration (Update these to match your local setup)
# Root: C:\AI-projects\afg_agno\AFGEstimateAnalyser
PROJECT_ROOT=C:\AI-projects\afg_agno\AFGEstimateAnalyser
EXTRACTOR_ROOT=C:\AI-projects\afg_agno\AFGEstimateAnalyser\ExtractorTool
MSAF_ROOT=C:\AI-projects\afg_agno\AFGEstimateAnalyser\MSAF
EXTRACTION_CONFIG_PATH=C:\AI-projects\afg_agno\AFGEstimateAnalyser\ExtractorTool\extraction_config.json
EXCEL_SOURCE_FILE=C:\AI-projects\afg_agno\afg_final\GTDPPPMOEEstimation20Toolkit_V_2 (version 1) - Waterfall.xltx
HTML_OUT_DIR=C:\AI-projects\afg_agno\AFGEstimateAnalyser\data\html_out
RESULTS_DIR=C:\AI-projects\afg_agno\AFGEstimateAnalyser\data\results_table

# API Configuration (Celery/Redis removed; workflow runs via FastAPI)
BACKEND_API_PORT=2357
EXTRACTION_SERVICE_URL=http://localhost:1204
